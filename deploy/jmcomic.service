[Unit]
Description=JMComic Telegram library (bot + reader)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jmcomic
Group=jmcomic
EnvironmentFile=/etc/jmcomic/jmcomic.env
Environment=JM_DATA_DIR=/var/lib/jmcomic HOME=/var/lib/jmcomic PYTHONUNBUFFERED=1
WorkingDirectory=/opt/jmcomic
ExecStart=/opt/jmcomic/venv/bin/python -m jmshelf
Restart=on-failure
RestartSec=10
TimeoutStopSec=20

# 主进程约 100–150MB；上传精选时生成 PDF 的子进程按卷处理，峰值约 300MB
MemoryHigh=700M
MemoryMax=900M

# 统计服务（含子进程）的入站和出站流量，Bot 的 /status 里显示
IPAccounting=yes

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/jmcomic

[Install]
WantedBy=multi-user.target
