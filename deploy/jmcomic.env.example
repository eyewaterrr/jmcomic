# /etc/jmcomic/jmcomic.env（权限 640，属主 root:jmcomic）。修改后 sudo systemctl restart jmcomic

# BotFather 给的 Token
TG_BOT_TOKEN=
# my.telegram.org 申请的 api_id / api_hash
TG_API_ID=
TG_API_HASH=
# 书库频道、精选频道的 ID（形如 -100xxxxxxxxxx）
TG_CHANNEL_ID=
TG_FAV_CHANNEL_ID=
# 所有者的 Telegram 用户 ID（白名单第一位）
TG_OWNER_ID=

# 阅读页网址（https，不带结尾斜杠）。留空则不显示“在线阅读”按钮
JM_PUBLIC_URL=

# 以下可选，括号里是默认值
# JM_HTTP_PORT=8730        阅读页本地端口（nginx 反代到这里）
# JM_CACHE_MB=1024         页面缓存上限
# JM_IMAGE_THREADS=4       下载图片线程数（1 核机器 4 就够）
# JM_PDF_QUALITY=85        收藏 PDF 的 JPEG 质量
# JM_PDF_VOLUME_MB=300     收藏 PDF 单卷上限（控制内存）
