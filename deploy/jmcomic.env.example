# /etc/jmcomic/jmcomic.env（权限 640，属主 root:jmcomic）。修改后 sudo systemctl restart jmcomic

# BotFather 给的 Token
TG_BOT_TOKEN=
# my.telegram.org 申请的 api_id / api_hash
TG_API_ID=
TG_API_HASH=
# 精选频道的 ID（形如 -100xxxxxxxxxx），上传精选的 PDF 发到这里
TG_FAV_CHANNEL_ID=
# 所有者的 Telegram 用户 ID（白名单第一位）
TG_OWNER_ID=

# 阅读页网址（https，不带结尾斜杠）。留空则不显示“在线阅读”按钮
JM_PUBLIC_URL=

# 以下可选，括号里是默认值
# JM_HTTP_PORT=8730        阅读页本地端口（nginx 反代到这里）
# JM_CACHE_MB=2048         原图缓存上限
# JM_CACHE_DAYS=7          超过这么多天没打开的章节从缓存里删除
# JM_READ_AHEAD=20         阅读时往后预读的页数
# JM_IMAGE_THREADS=4       同时从 JM 下载的图片数
# JM_PDF_QUALITY=85        精选 PDF 的 JPEG 质量
# JM_PDF_VOLUME_MB=300     精选 PDF 单卷上限（控制内存）

# JM 账号（可选，用于 /jmsync 同步 JM 收藏夹）。只在这台服务器上保存
JM_USERNAME=
JM_PASSWORD=
